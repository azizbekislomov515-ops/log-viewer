# Draft desktop entry (Phase 9 packaging installs it to /usr/share/applications and
# ships a real icon; until then the themed "utilities-log-viewer" icon is used).
# Validate with: desktop-file-validate packaging/loglens.desktop
[Desktop Entry]
Type=Application
Version=1.5
Name=LogLens
GenericName=Log Viewer
Comment=See every service's logs and what they mean
Exec=loglens
TryExec=loglens
Icon=utilities-log-viewer
Terminal=false
Categories=System;Monitor;
Keywords=log;logs;journal;journald;systemd;docker;compose;syslog;squid;nginx;clamav;
StartupNotify=true
StartupWMClass=loglens
SingleMainWindow=true
